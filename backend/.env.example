# Copy to .env. Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
DATABASE_URL=postgresql+psycopg://ariadne:ariadne_dev_password@localhost:5432/ariadne
ACCESS_TOKEN_EXPIRE_MINUTES=30
# JSON array, not a comma-separated string. Origins must match the browser's actual address.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
POSTGRES_USER=ariadne
POSTGRES_PASSWORD=ariadne_dev_password
POSTGRES_DB=ariadne
POSTGRES_IMAGE=postgres:17
